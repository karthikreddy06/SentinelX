# Application Settings
APP_NAME=SentinelX
DEBUG=True

# Database Configuration (PostgreSQL 18)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/sentinelx

# Redis & Caching
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_ENABLED=True

# Auth & Security
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Event Streaming & Kafka / Redpanda
STREAMING_ENABLED=True
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_CLIENT_ID=sentinelx-core
KAFKA_GROUP_ID=sentinelx-fraud-workers
KAFKA_TOPIC_TRANSACTIONS_CREATED=transactions.created
KAFKA_TOPIC_TRANSACTIONS_SCORED=transactions.scored
KAFKA_TOPIC_ALERTS_CREATED=alerts.created
KAFKA_TOPIC_TRANSACTIONS_DLQ=transactions.dlq

# Celery Background Workers & Schedulers
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
CELERY_STALE_ALERT_THRESHOLD_HOURS=24
CELERY_OUTBOX_RETENTION_DAYS=7

# Initial Admin (for create_admin script)
ADMIN_EMAIL=admin@sentinelx.local
ADMIN_PASSWORD=change-this-secure-admin-password
