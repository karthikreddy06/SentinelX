# Application Settings
APP_NAME=SentinelX
DEBUG=True

# Database Configuration (PostgreSQL 18)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/sentinelx

# Redis & Caching
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_ENABLED=True

# Auth & Security
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial Admin (for create_admin script)
ADMIN_EMAIL=admin@sentinelx.local
ADMIN_PASSWORD=change-this-secure-admin-password
